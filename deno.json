{
  "tasks": {
    "serve": "deno serve --watch --allow-net main.ts",
    "build": "deno run -A build.ts",
    "preview": {
      "command": "deno serve --watch --allow-net dist/worker.js",
      "dependencies": ["build"]
    },
    "format": "deno fmt src main*",
    "check": {
      "dependencies": ["check:format", "check:lint", "check:types", "check:test"]
    },
    "check:format": "deno fmt --check src main*",
    "check:lint": "deno lint",
    "check:types": "deno check **/*.ts",
    "check:test": "deno test -A"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/yaml": "jsr:@std/yaml@1",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "esbuild": "npm:esbuild@0.20.2"
  }
}
